<!DOCTYPE html>
<html lang="zh-CN">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0, user-scalable=no, viewport-fit=cover">
    <meta name="theme-color" content="#FF9A9E">
    <title>日记 - StudyPal</title>
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <script>
        (function() {
            var l = document.createElement('link');
            l.rel = 'stylesheet';
            l.href = 'https://fonts.googleapis.com/css2?family=Nunito:wght@400;500;600;700;800&family=Noto+Sans+SC:wght@400;500;700&display=swap';
            var n = document.querySelector('link[rel="stylesheet"]');
            n.parentNode.insertBefore(l, n);
        })();
    </script>
    <link rel="stylesheet" href="/static/css/variables.css">
    <link rel="stylesheet" href="/static/css/app.css">
    <link rel="stylesheet" href="/static/css/diary.css">
</head>
<body>

    <header class="top-bar">
        <div class="top-bar-left">
            <div>
                <div class="top-bar-greeting" id="top-greeting">你好</div>
                <div class="top-bar-date" id="top-date"></div>
            </div>
        </div>
        <div class="top-bar-right">
            <button class="btn-icon" onclick="window.location.href='/settings'" title="设置">
                <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                    <circle cx="12" cy="12" r="3"></circle>
                    <path d="M19.4 15a1.65 1.65 0 0 0 .33 1.82l.06.06a2 2 0 0 1 0 2.83 2 2 0 0 1-2.83 0l-.06-.06a1.65 1.65 0 0 0-1.82-.33 1.65 1.65 0 0 0-1 1.51V21a2 2 0 0 1-2 2 2 2 0 0 1-2-2v-.09A1.65 1.65 0 0 0 9 19.4a1.65 1.65 0 0 0-1.82.33l-.06.06a2 2 0 0 1-2.83 0 2 2 0 0 1 0-2.83l.06-.06a1.65 1.65 0 0 0 .33-1.82 1.65 1.65 0 0 0-1.51-1H3a2 2 0 0 1-2-2 2 2 0 0 1 2-2h.09A1.65 1.65 0 0 0 4.6 9a1.65 1.65 0 0 0-.33-1.82l-.06-.06a2 2 0 0 1 0-2.83 2 2 0 0 1 2.83 0l.06.06a1.65 1.65 0 0 0 1.82.33H9a1.65 1.65 0 0 0 1-1.51V3a2 2 0 0 1 2-2 2 2 0 0 1 2 2v.09a1.65 1.65 0 0 0 1 1.51 1.65 1.65 0 0 0 1.82-.33l.06-.06a2 2 0 0 1 2.83 0 2 2 0 0 1 0 2.83l-.06.06a1.65 1.65 0 0 0-.33 1.82V9a1.65 1.65 0 0 0 1.51 1H21a2 2 0 0 1 2 2 2 2 0 0 1-2 2h-.09a1.65 1.65 0 0 0-1.51 1z"></path>
                </svg>
            </button>
        </div>
    </header>

    {% include 'diary_view.html' %}

    <nav class="bottom-nav">
        <a class="nav-item" href="/home">
            <span class="nav-item-icon">&#127968;</span>
            <span class="nav-item-label">首页</span>
        </a>
        <a class="nav-item" href="/chat">
            <span class="nav-item-icon">&#128172;</span>
            <span class="nav-item-label">搭话</span>
        </a>
        <a class="nav-item active" href="/diary">
            <span class="nav-item-icon">&#128221;</span>
            <span class="nav-item-label">日记</span>
        </a>
        <a class="nav-item" href="/tasks">
            <span class="nav-item-icon">&#9745;</span>
            <span class="nav-item-label">任务</span>
        </a>
        <a class="nav-item" href="/settings">
            <span class="nav-item-icon">&#9881;</span>
            <span class="nav-item-label">设置</span>
        </a>
    </nav>

    <!-- Toast -->
    <div class="toast-container" id="toast-container"></div>

    <script src="/static/js/constants.js" defer></script>
    <script src="/static/js/api.js" defer></script>
    <script src="/static/js/state.js" defer></script>
    <script src="/static/js/pages/diary.js" defer></script>
    <script src="/static/js/app.js" defer></script>
    <script>
    (function() {
        if (!localStorage.getItem('token')) {
            window.location.href = '/login';
            return;
        }
        var theme = localStorage.getItem('theme') || 'light';
        document.documentElement.setAttribute('data-theme', theme);

        function initDiaryPage() {
            if (!window.App || !window.DiaryApp) {
                setTimeout(initDiaryPage, 50);
                return;
            }
            App._isSPA = false;
            App.token = localStorage.getItem('token');
            App.user = JSON.parse(localStorage.getItem('user') || 'null');
            if (App.applyTheme) App.applyTheme(theme);
            App.init();

            if (!window.diaryApp) {
                window.diaryApp = new DiaryApp();
            }
        }

        initDiaryPage();
    })();
    </script>
</body>
</html>
