# StudyPal 环境变量配置示例
# 复制此文件为 .env 并填写实际值

# ==================== 应用配置 ====================

# Flask 调试模式（生产环境设为 False）
FLASK_DEBUG=False

# Flask 密钥（生产环境请使用随机字符串）
# 生成方法：python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=

# 服务器配置
HOST=0.0.0.0
PORT=5000

# CORS 允许的来源（生产环境设为具体域名）
CORS_ORIGINS=*

# 日志级别
LOG_LEVEL=INFO

# ==================== AI 配置 ====================

# 默认模型配置 Key（对应 config.py 中的 MODELS_CONFIG）
# 可选值：
#   云端免费模型（推荐）：
#     groq_llama       - Llama 3.3 70B（Groq，极速）
#     groq_mixtral     - Mixtral 8x7B（Groq）
#     deepseek_chat    - DeepSeek Chat（DeepSeek）
#     deepseek_r1      - DeepSeek R1（DeepSeek，推理能力强）
#     openrouter_deepseek - DeepSeek R1（OpenRouter，完全免费）
#   本地模型（需要安装 Ollama）：
#     qwen3.5_9b      - Qwen3.5 9B（本地）
#     qwen2.5_7b      - Qwen2.5 7B（本地）
#     llama3_8b        - Llama3 8B（本地）
#     mistral_7b       - Mistral 7B（本地）
DEFAULT_MODEL_KEY=groq_llama

# 默认使用的模型名称（通常与 DEFAULT_MODEL_KEY 对应）
DEFAULT_MODEL=llama-3.3-70b-versatile

# AI API 密钥（使用云端模型时必填）
# 获取地址：
#   Groq: https://console.groq.com/keys
#   DeepSeek: https://platform.deepseek.com/api_keys
#   OpenRouter: https://openrouter.ai/keys
AI_API_KEY=your-api-key-here

# AI 请求超时时间（秒）
AI_TIMEOUT=60

# AI 请求最大重试次数
AI_MAX_RETRIES=3

# Ollama 服务地址（仅本地模型使用）
OLLAMA_BASE_URL=http://localhost:11434
