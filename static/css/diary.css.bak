/**
 * StudyPal 学习日记样式 v7.0
 */

/* ============================================================
 * 1. CSS 变量系统
 * ============================================================ */
:root {
  --color-bg: #fafaf8;
  --color-card: #ffffff;
  --color-text-primary: #1a1a1a;
  --color-text-secondary: #666666;
  --color-text-tertiary: #999999;
  --color-border: #e0e0e0;
  --color-border-light: #eeeeee;
  --color-accent: #1a1a1a;
  --color-danger: #cc3333;
  --color-danger-bg: #ffeeee;
  --radius-sm: 8px;
  --radius-md: 12px;
  --radius-lg: 16px;
  --radius-xl: 20px;
  --radius-full: 9999px;
  --shadow-sm: 0 1px 3px rgba(0,0,0,0.05);
  --shadow-md: 0 2px 8px rgba(0,0,0,0.08);
  --transition: all 0.2s ease;
}

/* ============================================================
 * 2. 全局重置 & 滚动条
 * ============================================================ */
* { box-sizing: border-box; }

body {
  background: var(--color-bg);
  color: var(--color-text-primary);
  font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, sans-serif;
  font-size: 14px;
  line-height: 1.5;
}

::-webkit-scrollbar { width: 6px; }
::-webkit-scrollbar-track { background: transparent; }
::-webkit-scrollbar-thumb { background: #ddd; border-radius: 3px; }
::-webkit-scrollbar-thumb:hover { background: #ccc; }

/* ============================================================
 * 3. View 切换动画
 * ============================================================ */
.page-view {
  display: none;
  opacity: 0;
  transform: translateY(10px);
  transition: opacity 0.3s, transform 0.3s;
}
.page-view.active {
  display: block;
  opacity: 1;
  transform: translateY(0);
}
#view-diary.active { display: block; }

/* ============================================================
 * 4. 主布局：左侧编辑区 + 右侧信息栏
 * ============================================================ */
#view-diary,
#view-history {
  overflow: visible !important;
}

.diary-shell {
  display: grid;
  grid-template-columns: minmax(0, 1fr) 300px;
  gap: 28px;
  align-items: start;
  overflow: visible;
  min-height: 600px;
}

.diary-editor-area {
  display: flex;
  flex-direction: column;
  gap: 0;
  min-width: 0;
}

/* ============================================================
 * 5. 顶部 Header
 * ============================================================ */
.diary-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 28px;
  padding: 0 4px;
}

.diary-title-main {
  font-size: 28px;
  font-weight: 700;
  letter-spacing: -0.5px;
  color: var(--color-text-primary);
  margin: 0;
}

.diary-actions {
  display: flex;
  align-items: center;
  gap: 12px;
}

.btn-text {
  background: transparent;
  border: none;
  color: var(--color-text-secondary);
  font-size: 14px;
  cursor: pointer;
  padding: 8px 12px;
  border-radius: var(--radius-md);
  transition: var(--transition);
}
.btn-text:hover { color: var(--color-text-primary); background: rgba(0,0,0,0.04); }

.btn-primary {
  background: var(--color-accent);
  color: white;
  border: none;
  padding: 10px 24px;
  border-radius: var(--radius-full);
  font-size: 14px;
  font-weight: 500;
  cursor: pointer;
  transition: var(--transition);
}
.btn-primary:hover { background: #333; transform: translateY(-1px); }
.btn-primary:active { transform: translateY(0); }

/* ============================================================
 * 6. 心情选择器
 * ============================================================ */
.mood-section {
  margin-bottom: 24px;
}

.mood-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 12px;
}

.section-title {
  font-size: 14px;
  font-weight: 600;
  color: #333;
}

.mood-debug {
  font-size: 12px;
  color: var(--color-text-tertiary);
}

.mood-grid {
  display: grid;
  grid-template-columns: repeat(4, 1fr);
  grid-template-rows: repeat(2, 1fr);
  gap: 8px;
}

.mood-item {
  aspect-ratio: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  gap: 5px;
  padding: 8px 4px;
  border-radius: var(--radius-lg);
  border: 2px solid transparent;
  background: #f5f5f0;
  cursor: pointer;
  transition: var(--transition);
}
.mood-item:hover { background: #ebebe5; transform: translateY(-2px); }
.mood-item.active {
  border-color: var(--color-accent);
  background: rgba(0,0,0,0.04);
}

.mood-emoji { font-size: 26px; line-height: 1; }

.mood-label {
  font-size: 11px;
  color: var(--color-text-secondary);
  text-align: center;
  max-width: 100%;
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
}

.mood-placeholder {
  border: 2px dashed #ddd;
  background: transparent;
  cursor: pointer;
}
.mood-placeholder::after {
  content: "+";
  font-size: 24px;
  color: #ccc;
}
.mood-placeholder:hover { background: transparent; transform: none; }

.mood-add-link {
  text-align: center;
  margin-top: 12px;
  font-size: 13px;
  color: var(--color-text-tertiary);
  cursor: pointer;
  transition: color 0.2s;
  padding: 6px;
}
.mood-add-link:hover { color: #666; }

/* ============================================================
 * 7. 标题输入框
 * ============================================================ */
.diary-title-input {
  width: 100%;
  border: none;
  border-bottom: 1px dashed #ccc;
  background: transparent;
  padding: 16px 0;
  font-size: 22px;
  font-weight: 600;
  color: var(--color-text-primary);
  outline: none;
  transition: border-color 0.2s;
  margin-bottom: 4px;
}
.diary-title-input:focus { border-bottom-color: #999; }
.diary-title-input::placeholder { color: #bbb; font-weight: 400; }

/* ============================================================
 * 8. 富文本编辑器（contenteditable）
 * ============================================================ */
.diary-content {
  width: 100%;
  min-height: 250px;
  border: none;
  background: transparent;
  padding: 20px 0;
  font-size: 15px;
  line-height: 1.8;
  color: #333;
  outline: none;
  white-space: pre-wrap;
  word-wrap: break-word;
}
.diary-content:empty::before {
  content: attr(placeholder);
  color: #bbb;
  pointer-events: none;
}

/* ============================================================
 * 9. 工具栏
 * ============================================================ */
.diary-toolbar {
  display: flex;
  align-items: center;
  gap: 12px;
  margin-top: 8px;
  padding-top: 12px;
  border-top: 1px solid var(--color-border-light);
}

.btn-image {
  width: 32px;
  height: 32px;
  border-radius: var(--radius-sm);
  border: 1px solid var(--color-border);
  background: white;
  cursor: pointer;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 16px;
  transition: var(--transition);
}
.btn-image:hover { background: #f5f5f0; border-color: #ccc; }

/* ============================================================
 * 10. 右侧信息栏
 * ============================================================ */
.diary-right-bar {
  position: relative;
  top: 0;
  display: flex;
  flex-direction: column;
  gap: 20px;
  min-height: 600px;
}

.right-section {
  background: var(--color-card);
  border: 1px solid var(--color-border-light);
  border-radius: var(--radius-lg);
  padding: 18px;
  box-shadow: var(--shadow-sm);
  min-height: 80px;
}

.right-mood-grid {
  display: grid;
  grid-template-columns: repeat(4, 1fr);
  gap: 6px;
  margin-top: 10px;
}

.right-mood-item {
  aspect-ratio: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  gap: 3px;
  padding: 6px 2px;
  border-radius: var(--radius-md);
  background: #f5f5f0;
  cursor: pointer;
  transition: var(--transition);
}
.right-mood-item:hover { background: #ebebe5; }
.right-mood-item.active {
  border: 2px solid var(--color-accent);
  background: rgba(0,0,0,0.04);
}
.right-mood-item .mood-emoji { font-size: 18px; }
.right-mood-item .mood-label { font-size: 9px; }

/* ============================================================
 * 11. 标签
 * ============================================================ */
.tag-list {
  display: flex;
  flex-wrap: wrap;
  gap: 8px;
  margin-bottom: 12px;
  margin-top: 10px;
}

.tag {
  padding: 5px 14px;
  border-radius: var(--radius-full);
  font-size: 13px;
  cursor: pointer;
  transition: var(--transition);
  border: 1px solid var(--color-border);
  background: white;
  color: var(--color-text-secondary);
}
.tag:hover { border-color: #ccc; }
.tag.active {
  background: var(--color-accent);
  color: white;
  border-color: var(--color-accent);
}

.tag-input {
  width: 100%;
  padding: 10px 14px;
  border: none;
  border-radius: var(--radius-md);
  font-size: 13px;
  outline: none;
  background: #f5f5f0;
  transition: var(--transition);
}
.tag-input:focus { background: white; box-shadow: 0 0 0 2px rgba(0,0,0,0.05); }
.tag-input::placeholder { color: #bbb; }

/* ============================================================
 * 12. 本周心情
 * ============================================================ */
.weekly-grid {
  display: flex;
  gap: 6px;
  margin-top: 10px;
}

.weekly-day {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 4px;
  padding: 8px 4px;
  border-radius: var(--radius-md);
  background: #f5f5f0;
}
.weekly-day.is-today {
  background: var(--color-accent);
  color: white;
}
.weekly-day .emoji { font-size: 18px; }
.weekly-day .day-name { font-size: 11px; color: var(--color-text-tertiary); }
.weekly-day.is-today .day-name { color: rgba(255,255,255,0.7); }
.weekly-day .day-date { font-size: 10px; color: #ccc; }
.weekly-day.is-today .day-date { color: rgba(255,255,255,0.5); }

.weekly-streak {
  text-align: center;
  margin-top: 12px;
  font-size: 13px;
  color: var(--color-text-tertiary);
}
.weekly-streak span { color: var(--color-accent); font-weight: 600; }

/* ============================================================
 * 13. 字数统计
 * ============================================================ */
.word-count-section {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding-top: 0;
}

.word-count-left {
  display: flex;
  align-items: baseline;
  gap: 4px;
}

.word-count-number {
  font-size: 36px;
  font-weight: 700;
  color: var(--color-text-primary);
  line-height: 1;
}

.word-count-unit {
  font-size: 13px;
  color: var(--color-text-tertiary);
}

.word-count-right {
  display: flex;
  align-items: center;
  gap: 8px;
}

.word-count-empty {
  font-size: 12px;
  color: var(--color-text-tertiary);
}

.word-count-mood {
  display: flex;
  align-items: center;
  gap: 6px;
}
.word-count-mood .emoji { font-size: 18px; }
.word-count-mood-tag {
  padding: 4px 12px;
  border-radius: var(--radius-md);
  font-size: 12px;
  background: #f5f5f0;
  color: var(--color-text-secondary);
}

/* ============================================================
 * 14. 历史记录页
 * ============================================================ */
.history-header {
  display: flex;
  align-items: center;
  gap: 16px;
  margin-bottom: 24px;
  padding: 0 4px;
}

.btn-back {
  display: flex;
  align-items: center;
  gap: 8px;
  font-size: 14px;
  color: var(--color-text-secondary);
  cursor: pointer;
  background: none;
  border: none;
  padding: 8px 12px;
  border-radius: var(--radius-md);
  transition: var(--transition);
}
.btn-back:hover { color: #333; background: rgba(0,0,0,0.04); }

.history-title-text {
  font-size: 22px;
  font-weight: 600;
  color: var(--color-text-primary);
  margin: 0;
  flex: 1;
}

.history-count {
  font-size: 13px;
  color: var(--color-text-tertiary);
}

.filter-bar {
  display: flex;
  align-items: center;
  gap: 12px;
  margin-bottom: 16px;
  padding: 0 4px;
}

.search-wrap { flex: 1; }

.search-input {
  width: 100%;
  padding: 10px 14px;
  border: none;
  border-radius: var(--radius-md);
  font-size: 14px;
  outline: none;
  background: #f5f5f0;
  transition: var(--transition);
}
.search-input:focus { background: white; box-shadow: 0 0 0 2px rgba(0,0,0,0.05); }
.search-input::placeholder { color: #bbb; }

.filter-toggle-btn {
  padding: 10px 16px;
  border: 1px solid var(--color-border);
  border-radius: var(--radius-md);
  background: white;
  font-size: 13px;
  cursor: pointer;
  transition: var(--transition);
  white-space: nowrap;
}
.filter-toggle-btn:hover { background: #f5f5f0; }

.filter-panel {
  display: none;
  padding: 16px;
  background: white;
  border: 1px solid var(--color-border-light);
  border-radius: var(--radius-lg);
  margin-bottom: 16px;
}
.filter-panel.show { display: block; }

.filter-group { margin-bottom: 12px; }
.filter-group:last-child { margin-bottom: 0; }
.filter-label {
  font-size: 12px;
  color: var(--color-text-tertiary);
  margin-bottom: 8px;
  text-transform: uppercase;
  letter-spacing: 0.05em;
}
.filter-chips { display: flex; flex-wrap: wrap; gap: 8px; }

.filter-chip {
  padding: 4px 12px;
  border-radius: var(--radius-full);
  font-size: 12px;
  cursor: pointer;
  border: 1px solid var(--color-border);
  background: white;
  color: var(--color-text-secondary);
  transition: var(--transition);
}
.filter-chip:hover { border-color: #ccc; }
.filter-chip.active {
  background: var(--color-accent);
  color: white;
  border-color: var(--color-accent);
}

/* 历史列表 */
.history-list {
  display: flex;
  flex-direction: column;
  gap: 12px;
}

.diary-history-item {
  display: flex;
  align-items: flex-start;
  gap: 16px;
  padding: 16px;
  border-radius: var(--radius-lg);
  background: white;
  cursor: pointer;
  transition: var(--transition);
  border: 1px solid transparent;
  animation: slideIn 0.3s ease;
}
.diary-history-item:hover {
  border-color: var(--color-border);
  box-shadow: var(--shadow-md);
  transform: translateY(-1px);
}

@keyframes slideIn {
  from { opacity: 0; transform: translateY(10px); }
  to   { opacity: 1; transform: translateY(0); }
}

.diary-history-item .history-emoji {
  font-size: 32px;
  width: 48px;
  height: 48px;
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
  background: #f5f5f0;
  border-radius: var(--radius-md);
}
.diary-history-item .history-content { flex: 1; min-width: 0; }
.diary-history-item .history-title-text-item {
  font-size: 16px;
  font-weight: 500;
  margin-bottom: 4px;
  color: var(--color-text-primary);
}
.diary-history-item .history-date {
  font-size: 13px;
  color: var(--color-text-tertiary);
  margin-bottom: 8px;
}
.diary-history-item .history-summary {
  font-size: 14px;
  color: var(--color-text-secondary);
  line-height: 1.5;
  display: -webkit-box;
  -webkit-line-clamp: 2;
  -webkit-box-orient: vertical;
  overflow: hidden;
}
.diary-history-item .history-tags {
  display: flex;
  flex-wrap: wrap;
  gap: 6px;
  margin-top: 8px;
}
.diary-history-item .history-tag {
  font-size: 11px;
  padding: 2px 8px;
  border-radius: var(--radius-full);
  background: #f5f5f0;
  color: var(--color-text-secondary);
}
.diary-history-item .history-delete {
  width: 32px;
  height: 32px;
  border-radius: var(--radius-sm);
  border: none;
  background: transparent;
  cursor: pointer;
  display: flex;
  align-items: center;
  justify-content: center;
  color: var(--color-text-tertiary);
  transition: var(--transition);
  flex-shrink: 0;
}
.diary-history-item .history-delete:hover {
  background: var(--color-danger-bg);
  color: var(--color-danger);
}

/* ============================================================
 * 15. 加载更多
 * ============================================================ */
.load-more-wrap {
  display: flex;
  justify-content: center;
  padding: 20px 0;
}

.load-more-btn {
  padding: 10px 32px;
  border: 1px solid var(--color-border);
  border-radius: var(--radius-full);
  background: white;
  font-size: 14px;
  color: var(--color-text-secondary);
  cursor: pointer;
  transition: var(--transition);
}
.load-more-btn:hover { background: #f5f5f0; color: var(--color-text-primary); }

/* ============================================================
 * 16. 弹窗
 * ============================================================ */
.modal-overlay {
  position: fixed;
  inset: 0;
  background: rgba(0,0,0,0.3);
  display: flex;
  align-items: center;
  justify-content: center;
  z-index: 100000;
  opacity: 0;
  pointer-events: none;
  transition: opacity 0.2s;
}
.modal-overlay.active { opacity: 1; pointer-events: auto; }

.modal-card {
  width: 90%;
  max-width: 560px;
  max-height: 80vh;
  background: white;
  border-radius: var(--radius-xl);
  padding: 28px;
  overflow-y: auto;
  transform: scale(0.95);
  transition: transform 0.2s;
}
.modal-overlay.active .modal-card { transform: scale(1); }

.modal-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 20px;
}

.modal-title {
  font-size: 20px;
  font-weight: 600;
  color: var(--color-text-primary);
  margin: 0;
}

.modal-close {
  width: 32px;
  height: 32px;
  border-radius: 50%;
  border: none;
  background: #f5f5f0;
  cursor: pointer;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 20px;
  color: var(--color-text-secondary);
  transition: var(--transition);
}
.modal-close:hover { background: #ebebe5; }

.modal-meta {
  display: flex;
  gap: 12px;
  margin-bottom: 16px;
  font-size: 13px;
  color: var(--color-text-tertiary);
}

.modal-content {
  font-size: 15px;
  line-height: 1.8;
  color: #333;
  margin-bottom: 16px;
}

.modal-tags {
  display: flex;
  flex-wrap: wrap;
  gap: 8px;
  margin-bottom: 24px;
}

.modal-tag {
  padding: 4px 12px;
  border-radius: var(--radius-md);
  font-size: 12px;
  background: #f5f5f0;
  color: var(--color-text-secondary);
}

.modal-actions {
  display: flex;
  gap: 12px;
  padding-top: 20px;
  border-top: 1px solid var(--color-border-light);
}

.btn-modal-edit,
.btn-modal-delete,
.btn-modal-cancel,
.btn-modal-confirm,
.btn-modal-discard {
  flex: 1;
  padding: 12px;
  border-radius: var(--radius-md);
  border: 1px solid var(--color-border);
  background: white;
  cursor: pointer;
  font-size: 14px;
  text-align: center;
  transition: var(--transition);
}
.btn-modal-edit:hover { background: #f5f5f0; }
.btn-modal-delete {
  border-color: var(--color-danger-bg);
  background: var(--color-danger-bg);
  color: var(--color-danger);
}
.btn-modal-delete:hover { background: #fee; }
.btn-modal-confirm {
  background: var(--color-accent);
  color: white;
  border-color: var(--color-accent);
}
.btn-modal-confirm:hover { background: #333; }
.btn-modal-cancel:hover { background: #f5f5f0; }
.btn-modal-discard {
  border-color: var(--color-danger-bg);
  background: var(--color-danger-bg);
  color: var(--color-danger);
}
.btn-modal-discard:hover { background: #fee; }

/* 自定义心情弹窗 */
.emoji-picker {
  display: grid;
  grid-template-columns: repeat(8, 1fr);
  gap: 8px;
  margin-bottom: 16px;
  max-height: 200px;
  overflow-y: auto;
}

.emoji-item {
  aspect-ratio: 1;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 22px;
  cursor: pointer;
  border-radius: var(--radius-sm);
  transition: background 0.2s;
}
.emoji-item:hover { background: #f5f5f0; }
.emoji-item.selected {
  background: #ebebe5;
  box-shadow: 0 0 0 2px var(--color-accent);
}

.mood-name-input {
  width: 100%;
  padding: 12px;
  border: 1px solid var(--color-border);
  border-radius: var(--radius-md);
  font-size: 14px;
  margin-bottom: 16px;
  outline: none;
  transition: border-color 0.2s;
}
.mood-name-input:focus { border-color: #999; }
.mood-name-input::placeholder { color: #bbb; }

.mood-value-slider { margin-bottom: 16px; }
.mood-value-slider label {
  display: flex;
  justify-content: space-between;
  font-size: 14px;
  color: var(--color-text-secondary);
  margin-bottom: 8px;
}
.mood-value-slider input[type="range"] { width: 100%; accent-color: var(--color-accent); }

.delete-warning {
  font-size: 14px;
  color: var(--color-text-secondary);
  margin-bottom: 8px;
}

/* ============================================================
 * 17. 图片 Lightbox
 * ============================================================ */
.lightbox-overlay {
  position: fixed;
  inset: 0;
  background: rgba(0,0,0,0.85);
  display: flex;
  align-items: center;
  justify-content: center;
  z-index: 2000;
  opacity: 0;
  pointer-events: none;
  transition: opacity 0.2s;
}
.lightbox-overlay.active { opacity: 1; pointer-events: auto; }

.lightbox-close {
  position: absolute;
  top: 20px;
  right: 20px;
  width: 40px;
  height: 40px;
  border-radius: 50%;
  border: none;
  background: rgba(255,255,255,0.15);
  color: white;
  font-size: 24px;
  cursor: pointer;
  display: flex;
  align-items: center;
  justify-content: center;
  transition: background 0.2s;
}
.lightbox-close:hover { background: rgba(255,255,255,0.25); }

.lightbox-img {
  max-width: 90%;
  max-height: 90vh;
  border-radius: var(--radius-lg);
  object-fit: contain;
}

/* ============================================================
 * 18. Toast
 * ============================================================ */
.diary-toast {
  position: fixed;
  bottom: 24px;
  left: 50%;
  transform: translateX(-50%) translateY(80px);
  background: var(--color-text-primary);
  color: white;
  padding: 10px 24px;
  border-radius: var(--radius-full);
  font-size: 14px;
  z-index: 9999;
  transition: transform 0.3s cubic-bezier(0.34, 1.56, 0.64, 1);
  pointer-events: none;
  white-space: nowrap;
}
.diary-toast.show { transform: translateX(-50%) translateY(0); }

/* ============================================================
 * 19. 编辑器内图片
 * ============================================================ */
.diary-content img {
  max-width: 100%;
  border-radius: var(--radius-md);
  margin: 8px 0;
  display: block;
  cursor: pointer;
}

/* ============================================================
 * 20. 空状态
 * ============================================================ */
.history-empty {
  text-align: center;
  padding: 48px 0;
  color: var(--color-text-tertiary);
}
.history-empty .empty-icon { font-size: 48px; margin-bottom: 12px; }
.history-empty .empty-title { font-size: 16px; font-weight: 500; color: var(--color-text-primary); margin-bottom: 6px; }
.history-empty .empty-desc { font-size: 14px; }

/* ============================================================
 * 21. 响应式
 * ============================================================ */
@media (max-width: 1200px) {
  .diary-right-bar { display: none; }
  .diary-shell { grid-template-columns: 1fr; }
}

@media (max-width: 768px) {
  .diary-title-main { font-size: 22px; }
  .mood-grid { grid-template-columns: repeat(4, 1fr); }
  .weekly-grid { gap: 4px; }
}

/* === 强制修复：覆盖 dashboard.css 冲突 === */
#view-diary.active {
  display: block !important;
  overflow: visible !important;
  height: auto !important;
  min-height: 100vh !important;
}

#view-diary.active .diary-shell {
  display: grid !important;
  grid-template-columns: minmax(0, 1fr) 300px !important;
  gap: 28px !important;
  align-items: start !important;
  overflow: visible !important;
  min-height: 600px !important;
}

#view-diary.active .diary-editor-area {
  display: flex !important;
  flex-direction: column !important;
  min-width: 0 !important;
  overflow: visible !important;
}

#view-diary.active .diary-right-bar {
  display: flex !important;
  flex-direction: column !important;
  gap: 20px !important;
  position: relative !important;
  top: 0 !important;
  visibility: visible !important;
  opacity: 1 !important;
}

#view-diary.active .mood-grid,
#view-diary.active .tag-list,
#view-diary.active .weekly-grid,
#view-diary.active .right-mood-grid {
  display: grid !important;
  visibility: visible !important;
  opacity: 1 !important;
}

#view-diary.active .tag-list {
  display: flex !important;
}

#view-diary.active .diary-content {
  display: block !important;
  min-height: 250px !important;
  color: #333 !important;
  opacity: 1 !important;
  visibility: visible !important;
}

#view-diary.active .mood-item,
#view-diary.active .tag,
#view-diary.active .right-mood-item {
  opacity: 1 !important;
  visibility: visible !important;
}
